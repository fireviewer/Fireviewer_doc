.env
.env.*
!.env.example

# Working documentation is deliberately local and never part of the public
# project narrative or component source documentation.
.local/
docs/local/
docs/work/
docs/private/

# Local or generated payloads do not belong in the documentation repository.
artifacts/
datasets/
media/
models/
outputs/
uploads/
checkpoints/
weights/

*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.zip
*.tar
*.7z
*.log

# The public set documents stable architecture, safety, governance, repository
# roles, and a dated capability boundary. Internal plans, runbooks, ADRs, and
# project tracking remain local and untracked.
docs/**
!docs/
!docs/public/
!docs/public/README.md
!docs/public/ARCHITECTURE.md
!docs/public/EVIDENCE_AND_REVIEW.md
!docs/public/RECONSTRUCTION.md
!docs/public/RESOURCES.md
!docs/public/DATA_GOVERNANCE.md
!docs/public/MAP_BUILDER.md
!docs/public/STATUS.md
!docs/public/REPOSITORIES.md
!docs/FUNDING_BRIEF.md
!docs/REPOSITORY_DOCUMENTATION_POLICY.md
!docs/LICENSING.md
templates/**
!templates/organization-profile/
!templates/organization-profile/github-metadata.yaml
!templates/storage-layout.local.example.json
