.env
.env.*
!.env.example

# Working documentation is deliberately local and never part of the public
# project narrative or component source documentation.
.local/
docs/local/
docs/work/
docs/private/

# Local or generated payloads do not belong in the documentation repository.
artifacts/
datasets/
media/
models/
outputs/
uploads/
checkpoints/
weights/

*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.zip
*.tar
*.7z
*.log

# Public documentation is intentionally concise.  Detailed plans, contracts,
# ADRs, status material and development notes remain local and untracked.
docs/**
!docs/
!docs/public/
!docs/public/README.md
!docs/FUNDING_BRIEF.md
!docs/REPOSITORY_DOCUMENTATION_POLICY.md
!docs/LICENSING.md
templates/
